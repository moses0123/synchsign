# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=SyncSign"
MONGODB_DB="syncsign"

# Long random string used to sign login sessions (e.g. `openssl rand -base64 48`)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used in emails, QR codes and signing links)
APP_URL="http://localhost:3000"

# Optional: comma-separated emails that are always admins (the first account created is also made admin)
ADMIN_EMAILS=""

# Optional fallback SMTP. Easier: configure email in the Admin portal → Email (SMTP), which overrides these.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SyncSign <no-reply@syncsign.app>"

# Optional: protects /api/cron/reminders (call it daily from Vercel Cron or any scheduler)
CRON_SECRET=""
